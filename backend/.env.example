# Copy to backend/.env and adjust. No secrets are needed for the MVP data sources.

# CORS: the frontend dev server origin.
FRONTEND_ORIGIN=http://localhost:5173
# More allowed CORS origins, comma-separated (e.g. local dev against a deployed API). Empty = none.
CORS_EXTRA_ORIGINS=

# Where `make data` writes prepared files and where the app reads them.
DATA_DIR=./data
# On-disk cache (snapshots, upstream responses).
CACHE_DIR=./.cache

# PostGIS with the CSB field polygons (docker-compose.yml, `make db`). Empty = no field polygons:
# every point resolves to a 500 m buffered point.
DATABASE_URL=postgresql://fieldshift:fieldshift@localhost:5433/fieldshift

# Field PMTiles in DATA_DIR, served at /v1/tiles/fields.pmtiles (Git LFS file, see README).
FIELDS_PMTILES_FILE=csb_ia_il_ne.pmtiles
# Optional: absolute URL of the same file on external hosting (CDN/R2). Empty = served by this backend.
FIELDS_PMTILES_URL=

LOG_LEVEL=INFO

# Auth. Access tokens are signed with JWT_SECRET (min 32 chars): `openssl rand -base64 48`.
# Empty = random per-process secret (dev only: every restart signs everyone out).
JWT_SECRET=
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=7
# Refresh token cookie. Frontend on a different site than the API (not just another port):
# AUTH_COOKIE_SECURE=true and AUTH_COOKIE_SAMESITE=none (HTTPS required).
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax

# Brevo SMTP: use the SMTP login and SMTP key from Brevo's SMTP page (not an API key).
# All three values are required to enable password reset emails. Keep real keys in .env only.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# A sender authenticated in Brevo. Empty disables recovery email.
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Field Shift
# Reset links use FRONTEND_ORIGIN above. Use your HTTPS frontend origin in production.

# Rotation analysis: the backend calls this private, stateless ML service over HTTP.
# `make ml` starts it on localhost:8001; `make up` connects API and ML inside Docker automatically.
ANALYSIS_ENGINE=ml
ML_BASE_URL=http://127.0.0.1:8001
ML_TIMEOUT_S=30
# Shared secret sent as X-ML-Token; set the same ML_API_TOKEN on the ML service when it is publicly reachable
# (hosted ML). Empty = no header (local ML).
ML_API_TOKEN=

# Analysis stub: total run time in seconds, and probability (0..1) that a job fails on purpose
# so the frontend can test the `failed` state.
# Used only with ANALYSIS_ENGINE=stub. Real ML never silently falls back to the stub.
STUB_DURATION_S=6
STUB_FAIL_RATE=0

# Per-client-IP limit for POST /analyses and POST /locations/resolve.
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_S=60

# Only for scripts/build_profit_baseline.py (never read by the API). Free key from
# https://quickstats.nass.usda.gov/api ; fills land rent from NASS cash rents. Never commit a real key.
NASS_API_KEY=
