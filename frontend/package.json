{
  "name": "fieldline-frontend",
  "version": "1.0.0",
  "scripts": {
    "dev": "vite",
    "dev:remote": "vite --mode remote",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:auth:browser": "node scripts/test-auth-browser.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "lint:fsd": "steiger ./src",
    "gen:api": "npx --yes -p openapi-typescript@7 -p typescript@5.9 openapi-typescript ../contract/openapi.yaml -o src/shared/api/schema.gen.ts"
  },
  "license": "UNLICENSED",
  "type": "module",
  "dependencies": {
    "@tanstack/react-query": "^5.107.1",
    "maplibre-gl": "^5.24.1",
    "openapi-fetch": "^0.17.0",
    "pmtiles": "^4.5.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.5"
  },
  "devDependencies": {
    "@feature-sliced/steiger-plugin": "^0.8.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^29.1.1",
    "msw": "^3.0.5",
    "playwright": "^1.65.1",
    "steiger": "^0.6.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "yaml": "^2.9.1"
  },
  "private": true,
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
